{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OCI Image Index",
  "description": "Minimal schema for OCI image index validation",
  "type": "object",
  "required": ["schemaVersion", "manifests"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [2]
    },
    "mediaType": {
      "type": "string",
      "enum": [
        "application/vnd.oci.image.index.v1+json",
        "application/vnd.docker.distribution.manifest.list.v2+json"
      ]
    },
    "manifests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["mediaType", "digest", "size"],
        "properties": {
          "mediaType": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "platform": {
            "type": "object",
            "properties": {
              "architecture": { "type": "string" },
              "os": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
