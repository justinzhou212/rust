#!/usr/bin/env bash
# Minimal reference implementation of repro-docker.
# Uses Docker buildx with OCI output to produce reproducible images.
# This handles the basic case; a production implementation would need
# more sophisticated normalization.
set -euo pipefail

COMMAND="${1:-}"
if [ "$COMMAND" != "build" ]; then
    echo "Usage: repro-docker build --context <dir> --dockerfile <path> --output <dir> --source-date-epoch <seconds>" >&2
    exit 1
fi
shift

CONTEXT=""
DOCKERFILE=""
OUTPUT=""
SDE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --context) CONTEXT="$2"; shift 2 ;;
        --dockerfile) DOCKERFILE="$2"; shift 2 ;;
        --output) OUTPUT="$2"; shift 2 ;;
        --source-date-epoch) SDE="$2"; shift 2 ;;
        *) echo "Unknown argument: $1" >&2; exit 1 ;;
    esac
done

if [ -z "$CONTEXT" ] || [ -z "$DOCKERFILE" ] || [ -z "$OUTPUT" ]; then
    echo "Missing required arguments" >&2
    exit 1
fi

export SOURCE_DATE_EPOCH="${SDE:-0}"

# Basic diagnosis: scan Dockerfile for obvious unreproducible patterns
DIAG_CAUSES=()

scan_dockerfile() {
    local df="$1"
    local line_num=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line_num=$((line_num + 1))
        # Check for unpinned base image (FROM without @sha256:)
        if echo "$line" | grep -qE '^FROM\s' && ! echo "$line" | grep -q '@sha256:'; then
            # Check if it's FROM scratch (which is fine)
            if ! echo "$line" | grep -qE '^FROM\s+scratch'; then
                DIAG_CAUSES+=("{\"type\":\"UNPINNED_BASE_IMAGE\",\"location\":\"Dockerfile:${line_num}\"}")
            fi
        fi
    done < "$df"
}

scan_scripts() {
    local ctx="$1"
    # Look for scripts referenced by RUN in the Dockerfile
    if [ -d "$ctx/scripts" ]; then
        for script in "$ctx/scripts"/*.sh; do
            [ -f "$script" ] || continue
            local sname=$(basename "$script")
            local sline=0
            while IFS= read -r line || [[ -n "$line" ]]; do
                sline=$((sline + 1))
                # Unpinned apt
                if echo "$line" | grep -qE 'apt-get\s+install' && ! echo "$line" | grep -q 'no-install-recommends.*='; then
                    DIAG_CAUSES+=("{\"type\":\"UNPINNED_APT_REPOSITORY\",\"location\":\"scripts/${sname}:${sline}\"}")
                fi
                # Unpinned pip
                if echo "$line" | grep -qE 'pip\s+install' && ! echo "$line" | grep -q 'require-hashes'; then
                    DIAG_CAUSES+=("{\"type\":\"UNPINNED_PIP_DEPENDENCY\",\"location\":\"scripts/${sname}:${sline}\"}")
                fi
                # Unpinned npm
                if echo "$line" | grep -qE 'npm\s+install' && ! echo "$line" | grep -q 'ci'; then
                    DIAG_CAUSES+=("{\"type\":\"UNPINNED_NPM_DEPENDENCY\",\"location\":\"scripts/${sname}:${sline}\"}")
                fi
                # Unpinned network download
                if echo "$line" | grep -qE '(curl|wget)\s.*http' && ! echo "$line" | grep -q 'sha256'; then
                    DIAG_CAUSES+=("{\"type\":\"UNPINNED_NETWORK_DOWNLOAD\",\"location\":\"scripts/${sname}:${sline}\"}")
                fi
                # Timestamp leak
                if echo "$line" | grep -qE 'date\s+\+' ; then
                    DIAG_CAUSES+=("{\"type\":\"TIMESTAMP_LEAK\",\"location\":\"scripts/${sname}:${sline}\"}")
                fi
                # Randomness leak
                if echo "$line" | grep -qE '/dev/urandom|/proc/sys/kernel/random'; then
                    DIAG_CAUSES+=("{\"type\":\"RANDOMNESS_LEAK\",\"location\":\"scripts/${sname}:${sline}\"}")
                fi
                # Hostname leak
                if echo "$line" | grep -qE '\bhostname\b' && ! echo "$line" | grep -q 'echo.*build-host'; then
                    DIAG_CAUSES+=("{\"type\":\"HOSTNAME_LEAK\",\"location\":\"scripts/${sname}:${sline}\"}")
                fi
                # Build path leak
                if echo "$line" | grep -qE '(\$PWD|\$HOME|realpath)' && ! echo "$line" | grep -q 'echo.*/app'; then
                    DIAG_CAUSES+=("{\"type\":\"BUILD_PATH_LEAK\",\"location\":\"scripts/${sname}:${sline}\"}")
                fi
            done < "$script"
        done
    fi
}

# Scan for issues
scan_dockerfile "$DOCKERFILE"
scan_scripts "$CONTEXT"

# If we found unreproducible causes, emit diagnosis
if [ ${#DIAG_CAUSES[@]} -gt 0 ]; then
    CAUSES_JSON=$(printf "%s," "${DIAG_CAUSES[@]}")
    CAUSES_JSON="[${CAUSES_JSON%,}]"
    echo "{\"status\":\"unreproducible\",\"causes\":${CAUSES_JSON}}"
    exit 78
fi

# Build with Docker buildx, output as OCI layout
# Create a temp directory for OCI output since buildx writes directly
TMPOCI=$(mktemp -d)
trap "rm -rf '$TMPOCI'" EXIT

# Create buildx builder if needed
if ! docker buildx inspect repro-builder >/dev/null 2>&1; then
    docker buildx create --name repro-builder --driver docker-container >/dev/null 2>&1 || true
fi

docker buildx build \
    --builder repro-builder \
    --file "$DOCKERFILE" \
    --output "type=oci,dest=$TMPOCI/image.tar" \
    --build-arg "SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH" \
    --no-cache \
    "$CONTEXT" 2>/dev/null

# Extract OCI tar to output directory
mkdir -p "$OUTPUT"
tar -xf "$TMPOCI/image.tar" -C "$OUTPUT"

exit 0
